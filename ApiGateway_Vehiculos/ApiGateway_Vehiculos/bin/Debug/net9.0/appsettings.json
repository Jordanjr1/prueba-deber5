{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "MiClaveSuperSecretaYUltraSeguraParaMicroservicios2026!",
    "Issuer": "Microservicio_Auth",
    "Audience": "ApiGateway_Vehiculos"
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "categoriasRoute": {
        "ClusterId": "categoriasCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/Categorias/{**catch-all}"
        }
      },
      "vehiculosRoute": {
        "ClusterId": "vehiculosCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/Vehiculos/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "authDestination": {
            "Address": "https://localhost:44337/"
          }
        }
      },
      "categoriasCluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "categoriasDestination": {
            "Address": "https://localhost:44306/"
          }
        }
      },
      "vehiculosCluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "vehiculosDestination": {
            "Address": "https://localhost:44320/"
          }
        }
      }
    }
  }
}